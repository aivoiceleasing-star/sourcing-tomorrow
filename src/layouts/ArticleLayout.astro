---
import BaseLayout from './BaseLayout.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  publishDate: string;
  category: string;
  categorySlug: string;
  author: string;
  featuredImage?: string;
  readTime: string;
  faq?: FaqItem[];
  keyTakeaways?: string[];
  keyStats?: { label: string; value: string; source?: string }[];
  dataTable?: { caption?: string; headers: string[]; rows: string[][]; source?: string };
  pullQuote?: { text: string; attribution?: string };
}

const {
  title,
  description,
  publishDate,
  category,
  categorySlug,
  author,
  featuredImage,
  readTime,
  faq,
  keyTakeaways,
  keyStats,
  dataTable,
  pullQuote,
} = Astro.props;

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Build Article JSON-LD
const articleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDate,
  author: author.includes('Tartaglia')
    ? {
        '@type': 'Person',
        '@id': 'https://www.sourcingtomorrow.com/author/claudio-tartaglia#person',
        name: author,
        url: 'https://www.sourcingtomorrow.com/author/claudio-tartaglia',
      }
    : {
        '@type': 'Person',
        name: author,
      },
  publisher: {
    '@type': 'Organization',
    name: 'SourcingTomorrow',
    url: 'https://www.sourcingtomorrow.com',
  },
};

if (featuredImage) {
  articleJsonLd.image = featuredImage.startsWith('http')
    ? featuredImage
    : `https://www.sourcingtomorrow.com${featuredImage}`;
}

// BreadcrumbList for rich results
const breadcrumbJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.sourcingtomorrow.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: 'https://www.sourcingtomorrow.com/articles/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: category,
      item: `https://www.sourcingtomorrow.com/categories/${categorySlug}/`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
    },
  ],
};

// Build combined JSON-LD (article + breadcrumb + optional FAQ)
const jsonLdBlocks: Record<string, unknown>[] = [articleJsonLd, breadcrumbJsonLd];

// The density blocks carry the article's evidence, so they are emitted as
// structured data as well as rendered: the takeaways as the Article abstract,
// each stat as a QuantitativeValue, the table as a Dataset, the pull quote as a
// Quotation. Without this the figures are visible to readers but invisible to
// anything parsing the page.
if (keyTakeaways && keyTakeaways.length > 0) {
  articleJsonLd.abstract = keyTakeaways.join(' ');
}

if (keyStats && keyStats.length > 0) {
  articleJsonLd.mentions = keyStats.map((stat) => ({
    '@type': 'QuantitativeValue',
    name: stat.label,
    value: stat.value,
    ...(stat.source ? { description: `Source: ${stat.source}` } : {}),
  }));
}

if (dataTable && dataTable.headers?.length > 0) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: dataTable.caption || `${title}: reference data`,
    description: dataTable.caption || `Reference table from ${title}`,
    ...(dataTable.source ? { creditText: dataTable.source } : {}),
    variableMeasured: dataTable.headers,
  });
}

if (pullQuote && pullQuote.text) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'Quotation',
    text: pullQuote.text,
    ...(pullQuote.attribution ? { creator: { '@type': 'Person', name: pullQuote.attribution } } : {}),
  });
}

if (faq && faq.length > 0) {
  jsonLdBlocks.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  ogImage={featuredImage}
  jsonLd={jsonLdBlocks}
>
  <article>
    <!-- Breadcrumb -->
    <div class="mx-auto max-w-3xl px-4 pt-8 sm:px-6 lg:px-8">
      <a
        href="/articles/"
        class="group inline-flex items-center text-sm font-medium text-neutral-500 transition-colors hover:text-brand-700"
      >
        <svg
          class="mr-1.5 h-4 w-4 transition-transform group-hover:-translate-x-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        All Articles
      </a>
    </div>

    <!-- Article Header -->
    <header class="mx-auto max-w-3xl px-4 pt-6 pb-8 sm:px-6 lg:px-8">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
        <a
          href={`/categories/${categorySlug}/`}
          class="rounded-full bg-brand-50 px-3 py-1 font-medium text-brand-700 transition-colors hover:bg-brand-100"
        >
          {category}
        </a>
        <span class="text-neutral-500">|</span>
        <time datetime={publishDate} class="text-neutral-500">
          {formattedDate}
        </time>
        <span class="text-neutral-500">|</span>
        {author.includes('Tartaglia') ? (
          <a
            href="/author/claudio-tartaglia"
            rel="author"
            class="font-medium text-neutral-700 underline-offset-4 hover:underline"
          >{author}</a>
        ) : (
          <span class="font-medium text-neutral-700">{author}</span>
        )}
        <span class="text-neutral-500">|</span>
        <span class="text-neutral-500">{readTime}</span>
      </div>

      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-neutral-900 lg:text-5xl">
        {title}
      </h1>
    </header>

    <!-- Featured Image -->
    {featuredImage && (
      <div class="mx-auto max-w-4xl px-4 pb-10 sm:px-6 lg:px-8">
        <img
          src={featuredImage}
          alt={`${title}: ${category} | Sourcing Tomorrow`}
          title={title}
          class="shadow-elevated w-full rounded-xl object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <!-- Key Takeaways -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-10 sm:px-6 lg:px-8">
        <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-6">
          <h2 class="text-sm font-semibold tracking-widest text-neutral-500 uppercase">
            Key takeaways
          </h2>
          <ul class="mt-4 space-y-3">
            {keyTakeaways.map((point) => (
              <li class="flex gap-3 leading-relaxed text-neutral-800">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-400"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Key Stats -->
    {keyStats && keyStats.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-10 sm:px-6 lg:px-8">
        <dl class="grid gap-4 sm:grid-cols-3">
          {keyStats.map((stat) => (
            <div class="rounded-xl border border-neutral-200 p-5">
              <dt class="text-3xl font-bold tracking-tight text-neutral-900">{stat.value}</dt>
              <dd class="mt-2 text-sm leading-snug text-neutral-700">{stat.label}</dd>
              {stat.source && (
                <dd class="mt-3 text-xs leading-snug text-neutral-500">{stat.source}</dd>
              )}
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Article Body -->
    <div class="prose-article mx-auto max-w-3xl px-4 pb-16 sm:px-6 lg:px-8">
      <slot />
    </div>

    <!-- Pull Quote -->
    {pullQuote && pullQuote.text && (
      <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 lg:px-8">
        <blockquote class="border-l-4 border-neutral-900 pl-6">
          <p class="text-xl leading-relaxed font-medium text-neutral-900 italic">
            {pullQuote.text}
          </p>
          {pullQuote.attribution && (
            <footer class="mt-3 text-sm text-neutral-600">{pullQuote.attribution}</footer>
          )}
        </blockquote>
      </section>
    )}

    <!-- Data Table -->
    {dataTable && dataTable.headers?.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 lg:px-8">
        {dataTable.caption && (
          <h2 class="mb-4 text-xl font-bold tracking-tight text-neutral-900">
            {dataTable.caption}
          </h2>
        )}
        <div class="overflow-x-auto rounded-xl border border-neutral-200">
          <table class="w-full border-collapse text-left text-sm">
            <thead class="bg-neutral-50">
              <tr>
                {dataTable.headers.map((h) => (
                  <th class="border-b border-neutral-200 px-4 py-3 font-semibold text-neutral-900">
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {dataTable.rows.map((row) => (
                <tr class="border-b border-neutral-100 last:border-0">
                  {row.map((cell) => (
                    <td class="px-4 py-3 align-top text-neutral-700">{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {dataTable.source && (
          <p class="mt-3 text-xs leading-snug text-neutral-500">{dataTable.source}</p>
        )}
      </section>
    )}

    <!-- FAQ Section -->
    {faq && faq.length > 0 && (
      <section class="mx-auto max-w-3xl border-t border-neutral-200 px-4 pt-12 pb-16 sm:px-6 lg:px-8">
        <h2 class="mb-8 text-2xl font-bold tracking-tight text-neutral-900">
          Frequently Asked Questions
        </h2>
        <dl class="space-y-6">
          {faq.map((item) => (
            <div class="rounded-lg border border-neutral-200 p-6">
              <dt class="text-lg font-semibold text-neutral-900">
                {item.question}
              </dt>
              <dd class="mt-2 leading-relaxed text-neutral-600">
                {item.answer}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Newsletter CTA -->
    <section class="border-t border-neutral-200 bg-neutral-50">
      <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
        <h2 class="mb-3 text-2xl font-bold tracking-tight text-neutral-900">
          Join the Discussion
        </h2>
        <p class="mx-auto mb-6 max-w-lg text-neutral-600">
          Get procurement insights, sourcing strategies, and supply chain intelligence delivered to your inbox.
        </p>
        <a
          href="/newsletter/"
          class="btn-primary px-6 py-3 text-sm"
        >
          Subscribe to the Newsletter
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
